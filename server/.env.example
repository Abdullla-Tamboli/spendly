NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/spendly?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
# Optional receipt uploads: configure these only in your private environment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional development seed password (otherwise generated once)
SEED_PASSWORD=

# Email OTP login configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_APP_PASSWORD=
